[Unit]
Description=MAINHALL agent message transport
After=network.target

[Service]
Type=simple
User=mainhall-relay
Group=mainhall-relay
WorkingDirectory=/opt/mainhall/ops/relay
EnvironmentFile=/etc/mainhall-relay.env
ExecStart=/usr/bin/python3 server.py
Restart=on-failure
RestartSec=1
StateDirectory=mainhall-relay
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mainhall-relay

[Install]
WantedBy=multi-user.target
