[Unit]
Description=MAINHALL private call desk
After=network.target

[Service]
Type=simple
User=mainhall-crm
Group=mainhall-crm
WorkingDirectory=/opt/mainhall-crm
Environment=MAINHALL_CRM_DATA=/var/lib/mainhall-crm
Environment=MAINHALL_CRM_ORIGIN=https://main-hall.ru
ExecStart=/usr/bin/python3 /opt/mainhall-crm/server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mainhall-crm
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
